{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kings-laundry-inline",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
 
  "vars": {
   
    "GITHUB_BRANCH": "final",
    "GITHUB_REPO": "Issa-Josiah/Laundry_website",
   
},

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}